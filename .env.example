# Server configuration
PORT=8000
SAFEMAP_ADMIN_PASSWORD=admin123

# MongoDB Atlas Free Tier Configuration:
# 1. Go to https://cloud.mongodb.com and create a free M0 cluster
# 2. In "Database Access", create a database user and password
# 3. In "Network Access", add IP Access (0.0.0.0/0 for anywhere or your current IP)
# 4. Click "Connect" -> "Drivers" -> Copy your Connection String and paste below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/safemap?retryWrites=true&w=majority
MONGODB_DB_NAME=safemap
