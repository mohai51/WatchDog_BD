# WatchDog BD Environment Configuration Template
NODE_ENV=development
PORT=8000

# Administrator Security
# In production, set a strong, random password (minimum 12 characters)
SAFEMAP_ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Secret key for HMAC token signing (minimum 32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAFEMAP_SECRET=generate_a_random_64_char_hex_secret_here

# MongoDB Atlas Configuration
# 1. Go to https://cloud.mongodb.com and create a free M0 cluster
# 2. In "Database Access", create a database user and password
# 3. In "Network Access", add IP Access (0.0.0.0/0 for serverless deployments like Vercel)
# 4. Click "Connect" -> "Drivers" -> Paste connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchdog_bd?retryWrites=true&w=majority
MONGODB_DB_NAME=watchdog_bd
